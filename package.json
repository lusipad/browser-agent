{
  "name": "browser-agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Claude-in-Chrome 风格的多模型浏览器智能体扩展（任意 OpenAI 兼容端点）",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "node test/run-unit.mjs",
    "test:e2e": "node --test test/e2e/collector.e2e.mjs test/e2e/extract.e2e.mjs",
    "sync-registry": "node scripts/sync-registry.mjs",
    "bench": "node eval/perception.bench.mjs",
    "bench:e2e": "node eval/agent-e2e.bench.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "gifenc": "^1.0.3",
    "marked": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2"
  }
}
